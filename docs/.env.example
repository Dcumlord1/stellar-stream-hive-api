# Base URL of the deployed docs site, with no trailing slash.
#
# Used by components/TechArticleJsonLd.tsx to build the absolute `url` and
# `mainEntityOfPage` fields in the TechArticle JSON-LD emitted on each docs
# page. Falls back to http://localhost:3000 when unset, which is fine for
# local development but must be set to the real production URL for deployed
# builds so structured data points at the right place.
NEXT_PUBLIC_SITE_URL=https://example.com
